 "doc_type": "Serial and Batch Bundle",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "hide_if_not_default": 0,
 "html": "\r\n<style>\r\n@page {\r\n    size: A4 portrait;\r\n    margin: 13.5mm 10mm;\r\n}\r\n\r\n* {\r\n    box-sizing: border-box;\r\n}\r\n\r\n.label-page {\r\n    width: 190mm;\r\n    display: grid !important;\r\n    grid-template-columns: repeat(3, 50mm);\r\n    justify-content: space-between;\r\n    column-gap: 0;\r\n    row-gap: 2mm;\r\n    align-content: start;\r\n    margin: 0;\r\n    padding: 0;\r\n    page-break-after: always;\r\n    break-after: page;\r\n}\r\n\r\n.serial-label {\r\n    width: 50mm;\r\n    height: 30mm;\r\n    margin: 0;\r\n    padding: 1mm;\r\n    display: flex !important;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    justify-content: center;\r\n    border: none !important;\r\n    outline: none !important;\r\n    box-shadow: none !important;\r\n    overflow: hidden;\r\n    break-inside: avoid;\r\n    page-break-inside: avoid;\r\n}\r\n\r\n.grade {\r\n    font-size: 8pt;\r\n    font-weight: bold;\r\n    margin-bottom: 0.5mm;\r\n}\r\n\r\n.grade-a { color: #008000; }\r\n.grade-b { color: #cc6600; }\r\n\r\n.product-name {\r\n    font-size: 7pt;\r\n    text-align: center;\r\n    margin-bottom: 0.5mm;\r\n}\r\n\r\n.serial-number {\r\n    font-size: 10pt;\r\n    font-weight: bold;\r\n    text-align: center;\r\n    margin-bottom: 0.5mm;\r\n}\r\n\r\n.serial-barcode {\r\n    display: block;\r\n    width: 46mm !important;\r\n    height: 13mm !important;\r\n    max-width: 46mm;\r\n    margin: 0 auto;\r\n}\r\n\r\n.item-code {\r\n    font-size: 7pt;\r\n    text-align: center;\r\n    margin-top: 0.5mm;\r\n}\r\n\r\n@media print {\r\n    .label-page {\r\n        display: grid !important;\r\n        grid-template-columns: repeat(3, 50mm) !important;\r\n        justify-content: space-between !important;\r\n    }\r\n\r\n    .serial-label {\r\n        border: none !important;\r\n    }\r\n}\r\n</style>\r\n\r\n{% if doc.docstatus != 1\r\n    or doc.is_cancelled\r\n    or doc.is_rejected\r\n    or doc.type_of_transaction != \"Inward\" %}\r\n\r\n<div style=\"padding:20px;color:red;font-weight:bold;\">\r\n    \u0e44\u0e21\u0e48\u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e1e\u0e34\u0e21\u0e1e\u0e4c\u0e09\u0e25\u0e32\u0e01\u0e44\u0e14\u0e49\r\n    <br>\r\n    \u0e15\u0e49\u0e2d\u0e07\u0e40\u0e1b\u0e47\u0e19 Serial and Batch Bundle \u0e17\u0e35\u0e48 Submit \u0e41\u0e25\u0e49\u0e27\r\n    \u0e41\u0e25\u0e30\u0e40\u0e1b\u0e47\u0e19\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23 Inward \u0e17\u0e35\u0e48\u0e44\u0e21\u0e48\u0e16\u0e39\u0e01\u0e22\u0e01\u0e40\u0e25\u0e34\u0e01\u0e2b\u0e23\u0e37\u0e2d\u0e1b\u0e0f\u0e34\u0e40\u0e2a\u0e18\r\n</div>\r\n\r\n{% else %}\r\n\r\n{% set valid_count = namespace(value=0) %}\r\n{% for row in doc.entries %}\r\n    {% if row.serial_no and not row.is_cancelled and not row.is_outward %}\r\n        {% set valid_count.value = valid_count.value + 1 %}\r\n    {% endif %}\r\n{% endfor %}\r\n\r\n{% if valid_count.value == 0 %}\r\n\r\n<div style=\"padding:20px;\">\u0e44\u0e21\u0e48\u0e1e\u0e1a Serial No \u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e1e\u0e34\u0e21\u0e1e\u0e4c</div>\r\n\r\n{% else %}\r\n\r\n{% set counter = namespace(value=0) %}\r\n\r\n{% for row in doc.entries %}\r\n{% if row.serial_no and not row.is_cancelled and not row.is_outward %}\r\n\r\n{% if counter.value % 27 == 0 %}\r\n<div class=\"label-page\">\r\n{% endif %}\r\n\r\n{% set code = row.item_code or doc.item_code %}\r\n\r\n<div class=\"serial-label\">\r\n\r\n    {% if code == \"FG-DESK-01-S\" %}\r\n        <div class=\"grade grade-a\">GRADE A</div>\r\n    {% elif code in [\"FG-DESK-01-B-S\", \"FG-DESK-01-B\"] %}\r\n        <div class=\"grade grade-b\">GRADE B</div>\r\n    {% else %}\r\n        <div class=\"grade\">PRODUCT</div>\r\n    {% endif %}\r\n\r\n    <div class=\"product-name\">{{ doc.item_name or code }}</div>\r\n\r\n    <div class=\"serial-number\">{{ row.serial_no }}</div>\r\n\r\n    <svg class=\"serial-barcode\"\r\n         data-value=\"{{ row.serial_no }}\"></svg>\r\n\r\n    <div class=\"item-code\">ITEM: {{ code }}</div>\r\n\r\n</div>\r\n\r\n{% set counter.value = counter.value + 1 %}\r\n\r\n{% if counter.value % 27 == 0 or counter.value == valid_count.value %}\r\n</div>\r\n{% endif %}\r\n\r\n{% endif %}\r\n{% endfor %}\r\n\r\n{% endif %}\r\n{% endif %}\r\n\r\n<script src=\"https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js\"></script>\r\n\r\n<script>\r\n(function () {\r\n    function makeBarcodes() {\r\n        if (typeof JsBarcode === \"undefined\") {\r\n            console.error(\"JsBarcode library not loaded\");\r\n            return;\r\n        }\r\n\r\n        document.querySelectorAll(\".serial-barcode\").forEach(function (svg) {\r\n            var serial = svg.getAttribute(\"data-value\");\r\n\r\n            if (!serial) return;\r\n\r\n            JsBarcode(svg, serial, {\r\n                format: \"CODE128\",\r\n                width: 2,\r\n                height: 45,\r\n                displayValue: false,\r\n                margin: 10,\r\n                marginLeft: 10,\r\n                marginRight: 10,\r\n                marginTop: 2,\r\n                marginBottom: 2,\r\n                lineColor: \"#000000\",\r\n                background: \"#ffffff\"\r\n            });\r\n        });\r\n    }\r\n\r\n    if (document.readyState === \"loading\") {\r\n        document.addEventListener(\"DOMContentLoaded\", makeBarcodes);\r\n    } else {\r\n        makeBarcodes();\r\n    }\r\n})();\r\n</script>\r\n",
